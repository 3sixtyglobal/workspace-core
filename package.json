{
	"name": "3sixty-workspace-core",
	"version": "0.0.0",
	"description": "Workspace Core",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/3sixtyglobal/workspace-core.git"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"private": true,
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"package:update": "pnpm update --interactive --latest",
		"submodule:install": "node ./scripts/submodules.mjs install",
		"submodule:format": "node ./scripts/submodules.mjs format",
		"submodule:lint": "node ./scripts/submodules.mjs lint",
		"submodule:lint:code": "node ./scripts/submodules.mjs lint:code",
		"submodule:dist": "node ./scripts/submodules.mjs dist",
		"submodule:dist-no-test": "node ./scripts/submodules.mjs dist-no-test",
		"submodule:test": "node ./scripts/submodules.mjs test",
		"submodule:docs": "node ./scripts/submodules.mjs docs",
		"submodule:quality": "node ./scripts/submodules.mjs quality",
		"submodule:quality-no-test": "node ./scripts/submodules.mjs quality-no-test",
		"submodule:format-lint-dist-docs": "node ./scripts/submodules.mjs format-lint-dist-docs",
		"submodule:package-update": "node ./scripts/submodules.mjs package-update",
		"submodule:align-main": "node ./scripts/submodule-align.mjs main",
		"submodule:align-next": "node ./scripts/submodule-align.mjs next",
		"workspace:install": "pnpm install --force",
		"workspace:format": "node ./scripts/workspace-run.mjs format --repos",
		"workspace:lint": "node ./scripts/workspace-run.mjs lint --repos",
		"workspace:build": "node ./scripts/workspace-run.mjs build",
		"workspace:dist": "node ./scripts/workspace-run.mjs dist",
		"workspace:dist-no-test": "node ./scripts/workspace-run.mjs dist:no-test",
		"workspace:test": "node ./scripts/workspace-run.mjs test",
		"workspace:test:bun": "node ./scripts/workspace-run.mjs test:bun",
		"workspace:quality": "pnpm run workspace:format && pnpm run workspace:dist && pnpm run workspace:lint",
		"workspace:quality-no-test": "pnpm run workspace:format && pnpm run workspace:dist-no-test && pnpm run workspace:lint"
	},
	"submodules": [
		"framework",
		"tools",
		"data",
		"standards",
		"api",
		"entity-storage",
		"logging",
		"background-task",
		"telemetry",
		"tracing",
		"authorization",
		"event-bus",
		"vault",
		"blob-storage",
		"automation",
		"api-auth",
		"data-processing",
		"messaging",
		"dlt",
		"wallet",
		"identity",
		"nft",
		"notarization",
		"trust",
		"attestation",
		"immutable-proof",
		"auditable-item-graph",
		"auditable-item-stream",
		"document-management",
		"rights-management",
		"federated-catalogue",
		"dataspace",
		"engine",
		"node"
	],
	"type": "module",
	"devDependencies": {
		"@octokit/rest": "22.0.1",
		"glob": "13.0.6",
		"prettier": "3.9.8"
	},
	"bugs": {
		"url": "git+https://github.com/3sixtyglobal/workspace-core/issues"
	},
	"homepage": "https://3sixty.global"
}
